# The Odds API key — NEVER commit the real value, keep this in .env.local only
ODDS_API_KEY=your_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com

# Region for bookmaker odds: eu, us, uk, au (see https://the-odds-api.com/liveapi/guides/v4/#region-filtering)
DEFAULT_ODDS_REGION=eu

# Bookmaker to prefer when multiple are returned. Leave blank to auto-select best price per outcome.
DEFAULT_BOOKMAKER=

# decimal is the only format Betora displays
ODDS_FORMAT=decimal

# How often the frontend should poll live events, in milliseconds
LIVE_ODDS_REFRESH_INTERVAL=15000

# When true (or when ODDS_API_KEY is missing), the server serves bundled mock data instead of calling the real API.
# Never leave this true in production.
USE_MOCK_DATA=true

# Port the Express server listens on
PORT=8787

# Comma-separated list of origins allowed to call this server (your frontend's dev/prod URL)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Virtual Football — a simulated match cycle, not real sports data.
# Total cycle length must be >= betting window + match length.
VIRTUAL_CYCLE_SECONDS=250
VIRTUAL_BETTING_WINDOW_SECONDS=180
VIRTUAL_MATCH_LENGTH_SECONDS=60
